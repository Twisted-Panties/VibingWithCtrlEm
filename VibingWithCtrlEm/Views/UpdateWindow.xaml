<Window x:Class="VibingWithCtrlEm.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Available — Vibing With CtrlEm"
        Width="640" Height="480"
        MinWidth="450" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content / Notes -->
            <RowDefinition Height="*"/>
            <!-- Progress / Status Area -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             HEADER
             ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🚀  New Update Available!"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"/>
                    <TextBlock x:Name="TxtReleaseTitle"
                               Text="Release v0.0.0"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="{DynamicResource AccentSecondaryBrush}"
                            CornerRadius="4"
                            Padding="8,4">
                        <TextBlock x:Name="TxtVersionBadge"
                                   Text="v0.0.0"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0D1B2A"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             BODY: Versions & Release Notes
             ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Version Comparison Info -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENT VERSION"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock x:Name="TxtCurrentVersion"
                                   Text="v0.9.1"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="➔"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentSecondaryBrush}"
                               Margin="16,0"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="NEW VERSION"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Right"/>
                        <TextBlock x:Name="TxtNewVersion"
                                   Text="v0.9.2"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentSecondaryBrush}"
                                   TextAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Release Notes / Changelog -->
            <Border Grid.Row="1"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <FlowDocumentScrollViewer x:Name="ViewerChangelog"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             PROGRESS & STATUS (Shown during download)
             ═══════════════════════════════════════════════ -->
        <StackPanel x:Name="PanelProgress"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Margin="18,0,18,10">
            <TextBlock x:Name="TxtDownloadStatus"
                       Text="Downloading update... 0%"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,4"/>
            <ProgressBar x:Name="ProgressBarDownload"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{DynamicResource AccentSecondaryBrush}"
                         Background="{DynamicResource InputBgBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════
             FOOTER: Buttons
             ═══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtError"
                           Grid.Column="0"
                           Text=""
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusDisconnectedBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>

                <Button x:Name="BtnLater"
                        Grid.Column="1"
                        Content="Later"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="BtnLater_Click"/>

                <Button x:Name="BtnUpdate"
                        Grid.Column="2"
                        Content="Update &amp; Restart"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="130"
                        Click="BtnUpdate_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
